                              <tbody>
                                 <tr>
                                    <td align="center" valign="middle" class="mcnButtonContent" style="font-family:'Inter', 'Helvetica Neue', 'Helvetica', 'Arial', 'sans-serif'; font-size: 25px; padding: 12px 36px;">
                                       <a class="mcnButton " title="Open CRM case" href="https://ilabank.lightning.force.com/lightning/r/Case/{!Case.Id}/view" target="_blank" style="font-weight: normal;letter-spacing: normal;line-height: 100%;text-align: center;text-decoration: none;color: #00153e;">Open CRM case</a>
                                    </td>
                                 </tr>
                              </tbody>
                           </table>
                        </td>
                     </tr>
                     <tr>
                        <td align="center" style="padding: 0px 18px 9px;">
                           <br>
