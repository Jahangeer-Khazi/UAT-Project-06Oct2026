                                    <a href="https://www.youtube.com/channel/UC_ycAB7SYwy1B5G7MRgJrFw" target="_blank"><img src="https://images.ctfassets.net/2c8e80nprabl/5HxpWe7yNAkUdZz9AL83cK/15749342a20c0ddc0c41a336ab213b78/ilaemails_youtube.png" alt="YouTube" style="display:block;" height="40" width="40" class=""></a>
                                 </td>
                              </tr>
                           </table>
                        </td>
                     </tr>
                     <tr>
                        <td align="center" style="padding: 0px 18px 9px;">
                           <br>
                           <span><a style="color:#7aee00; text-decoration:none;" href="https://www.ilabank.com" target="_blank">ilabank.com</a></span>
                        </td>
                     </tr>
                     <tr>
                        <td align="center" style="padding: 0px 18px 9px;">
                           <br>
                           <span style="color:#FFFFFF; text-decoration: none;">Powered by Bank ABC</span>
                        </td>
                     </tr>
                     <tr>
                        <td align="center" style="padding: 0px 18px 9px;">
                           <br>
                           <span style="color:#ffffff; text-decoration: none;"><a style="color: #79ED00; text-decoration: none; font-size:12px;" href="https://goo.gl/maps/XiabGNQGbBAEJpcr9" target="_blank">Bank ABC Tower, Head Office, P.O Box: 5698, Manama, Kingdom of Bahrain</a></span>
                        </td>
                     </tr>
                     <tr>
                        <td align="center" style="padding: 0px 18px 9px;">
                           <br>
                           <span style="color:#ffffff; font-size:12px; text-decoration: none;">This email and any files transmitted with it are confidential and intended solely for the use of the individual or entity to whom they are addressed. If you have received this email in error, please notify the system manager.</span>
                        </td>
                     </tr>
                     <tr>
