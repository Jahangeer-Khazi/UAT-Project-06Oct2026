                                        width="300" style="max-width:300px; display:inline-block; display:block;"></a>
                            </td>
                        </tr>
                        <tr>
                            <td align="center" style="padding: 0px 18px 9px;">
                                <br>
                                <br>
                                <span
                                    style="text-align: center; font-size:30px; max-width:440px; text-decoration: none; color:#79ED00;">Loan
                                    Advanced Pay Request Cancelled</span>
                            </td>
                        </tr>
                        <tr>
                            <td align="left" style="padding: 0px 18px 9px;">
                                <span style="text-align: left; font-size:18px; color:#ffffff;text-decoration: none;">
                                    Hi,
                                    <br>
                                    <br>
                                    Your Loan Request Regarding Advanced Pay was cancelled.

                                    <br> Please use the request ID {!Case.CaseNumber} to follow up.
                                    <br>
                                    For any Questions, call us on &nbsp;<a href="tel:+97317123460"
                                        style="color:#ffffff; text-decoration:none;">+973 17123460</a>&nbsp;.

                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td align="center" style="padding: 0px 18px 9px;">
                                <br>
                                <br>
                                <!--[if mso]>
										<v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="https://gateway.ilabank.com/redirect/mobile" style="height:45px;v-text-anchor:middle;width:250px;" arcsize="75%" stroke="f" fillcolor="#79ED00">
										  <w:anchorlock/>
										  <center>
									  <![endif]-->
                                <a href="https://gateway.ilabank.com/redirect/mobile"
                                    style="background-color:#79ED00;border-radius:30px;color:#000000;display:inline-block;font-size:20px;line-height:45px;text-align:center;text-decoration:none;width:250px;-webkit-text-size-adjust:none;">Open
                                    ila App</a>
                                <!--[if mso]>
										</center>
										</v:roundrect>
								  <![endif]-->
                            </td>
                        </tr>

                        <tr>
                            <td align="center" style="padding: 0px 18px 9px;">
                                <br>
                                <span style="color:#ffffff; text-decoration: none;"><a
