<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description
  >LWC version of the creditCardInfo Aura component, used on the Manual Authentication Flow screens</description>
    <isExposed>true</isExposed>
    <masterLabel>creditCardInfoLWC</masterLabel>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>

    <targetConfigs>

        <targetConfig targets="lightning__FlowScreen">

            <property
        name="customerId"
        type="String"
        role="inputOnly"
        label="Account Id"
      />

            <property
        name="cifNumber"
        type="String"
        role="inputOnly"
        label="Customer CIF"
      />

        </targetConfig>

    </targetConfigs>
</LightningComponentBundle>
